{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@pages/*":      ["src/pages/*"],
      "@store/*":      ["src/store/*"],
      "@services/*":   ["src/services/*"],
      "@hooks/*":      ["src/hooks/*"],
      "@app-types/*":  ["src/types/*"],
      "@constants/*":  ["src/constants/*"],
      "@utils/*":      ["src/utils/*"],
      "@styles/*":     ["src/styles/*"],
      "@assets/*":     ["src/assets/*"]
    }
  },
  "include": ["src"]
}
